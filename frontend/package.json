{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:analyze": "tsc --noEmit && vite build --mode analyze",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "bundle:analyze": "npx vite-bundle-analyzer dist"
  },
  "dependencies": {
    "@aws-amplify/backend-function": "^1.14.1",
    "@aws-amplify/ui-react": "^6.5.5",
    "@aws-sdk/client-bedrock-agentcore": "^3.896.0",
    "@aws-sdk/client-bedrock-agentcore-control": "^3.896.0",
    "@aws-sdk/client-lambda": "^3.840.0",
    "@xyflow/react": "^12.8.6",
    "aws-amplify": "^6.15.6",
    "react": "^18.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.0.18",
    "react-router-dom": "^7.6.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.18.0",
    "@aws-amplify/backend-cli": "^1.8.0",
